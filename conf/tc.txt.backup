# multiple line text-based transformation catalog: 2010-12-03T09:30:08.870-08:00
tr pegasus::mpiexec {
	site kraken {
		profile globus "maxwalltime" "120"
		profile globus "host_count" "20"
		profile globus "count" "240"
		profile globus "jobtype" "single"
		#pfn "/lustre/scratch/proj/tera3d/pegasus/default/bin/pegasus-mpi-cluster"
		pfn "/lustre/scratch/proj/tera3d/CyberShake/utils/pegasus_wrappers/mpi-cluster-wrapper.sh"
		arch "x86_64"
		os "LINUX"
		type "INSTALLED"
	}

	site stampede {
                profile globus "maxwalltime" "60"
                profile globus "host_count" "64"
		profile globus "count" "1024"
                profile globus "jobtype" "single"
		profile globus "queue" "normal"
                #pfn "/work/00940/tera3d/pegasus/pegasus_wrappers/mpi-cluster-wrapper.sh"
                pfn "/work/00940/tera3d/pegasus/pegasus_wrappers/mpi-cluster-wrapper-impi.sh"
                arch "x86_64"
                os "LINUX"
                type "INSTALLED"
	}

	site bluewaters {
		profile globus "maxwalltime" "120"
		profile globus "hostcount" "96"
		profile globus "count" "3072"
		profile globus "jobtype" "single"
		profile globus "nodetype" "xe"
		profile pegasus "cores" "3072"
		#profile globus "project" "baln"
		profile globus "queue" "noalloc"
		pfn "/projects/sciteam/baln/CyberShake/utils/pegasus_wrappers/mpi-cluster-wrapper.sh"
		arch "x86_64"
		os "LINUX"
		type "INSTALLED"
	}

	#site titan-pilot {
	#	profile condor "requirements" "(IsPilot==True)"
	#	profile condor "requirements" "(PilotTimeLeft>7200)"
        #        pfn "/lustre/atlas/proj-shared/geo112/CyberShake/utils/pegasus_wrappers/mpi-cluster-wrapper.sh"
        #        arch "x86_64"
        #        os "LINUX"
        #        type "INSTALLED"
	#}

	site titan {
		profile globus "maxwalltime" "120"
		profile globus "hostcount" "192"
		profile globus "count" "3072"
		profile globus "jobtype" "single"
		profile globus "account" "GEO112"
                profile pegasus "cores" "3072"
		pfn "/lustre/atlas/proj-shared/geo112/CyberShake/utils/pegasus_wrappers/mpi-cluster-wrapper.sh"
                arch "x86_64"
                os "LINUX"
                type "INSTALLED"
	}
    site summit {
			profile globus "maxwalltime" "60"
            #profile globus "maxwalltime" "720"
			profile globus "hostcount" "4"
            #profile globus "hostcount" "92"
            profile globus "jobtype" "single"
            profile globus "project" "GEO112"
            pfn "/gpfs/alpine/proj-shared/geo112/CyberShake/utils/pegasus_wrappers/mpi-cluster-wrapper.sh"
            arch "x86_64"
            os "LINUX"
            type "INSTALLED"
    }
    #    site summit-pilot {
    #            profile condor "requirements" "(IsPilot==True)"
    #            profile condor "requirements" "(TARGET.Arch==\"ppc64le\")"
    #            pfn "/gpfs/alpine/proj-shared/geo112/CyberShake/utils/pegasus_wrappers/mpi-cluster-wrapper.sh"

tr pegasus::transfer {
	site local {
		profile condor "universe" "vanilla"
		profile condor "requirements" "(Machine==\"shock.hpc.usc.edu\")"
		pfn "/home/shock-ssd/scottcal/pegasus/default/bin/pegasus-transfer"
		#pfn "/home/shock-ssd/scottcal/pegasus/pegasus-wrappers/go_transfer_wrapper.py"
		arch "x86"
		os "LINUX"
		type "INSTALLED"
	}
	#Move staging for summit-pilot out of glideins
	site summit-pilot {
		profile pegasus "style" "glite"
		profile condor "universe" "grid"
        profile globus "maxwalltime" "30"
        profile globus "hostcount" "1"
        profile globus "jobtype" "single"
        profile globus "project" "GEO112"
        profile pegasus "change.dir" "true"
        profile condor "grid_resource" "batch lsf /tmp/cybershk.summit.sock"
        profile pegasus "queue" "batch"
        profile condor "batch_queue" "batch"
        profile env "PEGASUS_HOME" "/gpfs/alpine/proj-shared/geo112/CyberShake/utils/pegasus/default"
        profile pegasus "X509_USER_PROXY" "/home/shock-ssd/scottcal/condor/x509up_u7588"
		pfn "/gpfs/alpine/proj-shared/geo112/CyberShake/utils/pegasus/default/bin/pegasus-transfer"
		arch "x86_64"
		os "LINUX"
		type "INSTALLED"
	}

	#Adding this to try to pick up correct account for frontier
	site frontier {
		profile pegasus "nodes" "1"
		profile pegasus "cores" "1"
		profile globus "maxwalltime" "60"
		profile globus "project" "GEO156"
		pfn "/lustre/orion/geo156/proj-shared/CyberShake/utils/pegasus/default/bin/pegasus-transfer"
		arch "x86_64"
		os "LINUX"
		type "INSTALLED"
	}

	#Adding this to get the node/core counts Frontera requires
	site frontera {
		profile pegasus "nodes" "1"
		profile pegasus "cores" "1"
		profile globus "maxwalltime" "60"
		profile globus "queue" "small"
		pfn "/work2/00349/scottcal/frontera/CyberShake/utils/pegasus/default/bin/pegasus-transfer"
		arch "x86_64"
        os "LINUX"
        type "INSTALLED"
	}
}

tr condor::dagman {
	site local {
		profile condor "universe" "scheduler"
		profile dagman "POST" "none"
		pfn "/usr/bin/condor_dagman"
		arch "x86"
		os "LINUX"
		type "INSTALLED"
	}
}

